#!/usr/bin/env python3
# akstaging/akamaistaging
"""
Akamai Staging Application.
This script serves as the main entry point for the Akamai Staging GUI application.
"""

import logging
import sys

python_site_packages_path = "@PYTHON_SITE_PACKAGES@"
if python_site_packages_path not in sys.path:
    sys.path.insert(0, python_site_packages_path)

from akstaging import get_gio_settings, setup_gsettings_schema_dirs, setup_icon_theme_paths

setup_gsettings_schema_dirs()

import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk

from akstaging.i18n import get_translator, set_language
from akstaging.preferences import Preferences, apply_theme
from akstaging.window import AkamaiStagingWindow

# This import will now work correctly
from akstaging.defs import SETTINGS_ID


class AkamaiApp(Adw.Application):
    """The main Adwaita Application class for Akamai Staging."""

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.window = None

        self.settings = get_gio_settings(SETTINGS_ID)
        self.settings.connect("changed::theme", lambda s, k: self.apply_theme())
        self.settings.connect(
            "changed::language", lambda s, k: self.apply_language()
        )
        self.settings.connect(
            "changed::font-scale", lambda s, k: self.apply_font_scaling()
        )

    def do_startup(self):
        """Called when the application starts, before activate."""
        Adw.Application.do_startup(self)
        display = Gdk.Display.get_default()
        setup_icon_theme_paths(display)
        self.apply_language()
        self.apply_theme()
        self.apply_font_scaling()

    def apply_language(self):
        """Applies language scheme across C GLib/GTK textdomains and retranslates active window."""
        lang_str = self.settings.get_string("language")
        set_language(lang_str)
        if self.window and hasattr(self.window, "retranslate_ui"):
            self.window.retranslate_ui()

    def do_activate(self):
        """Handles the 'activate' signal of the Adw.Application."""
        if not self.window:
            self.window = AkamaiStagingWindow(application=self)
        self.window.present()

    def apply_theme(self):
        """Applies the color scheme based on the 'theme' GSettings key."""
        theme_str = self.settings.get_string("theme")
        apply_theme(theme_str, Gdk.Display.get_default())
        logging.info("Applied theme: %s", theme_str)

    def apply_font_scaling(self, scale_factor=None):
        """Applies font scaling factor via GtkSettings across Linux, macOS, and BSD."""
        if scale_factor is None:
            try:
                scale_factor = self.settings.get_double("font-scale")
            except Exception:
                scale_factor = 1.0

        logging.info("Applying font scale factor: %s", scale_factor)
        display = Gdk.Display.get_default()
        if display:
            settings = Gtk.Settings.get_for_display(display)
            if settings:
                dpi_value = int(96 * 1024 * scale_factor) if abs(scale_factor - 1.0) > 0.01 else -1
                settings.set_property("gtk-xft-dpi", dpi_value)


if __name__ == "__main__":
    logging.basicConfig(level=logging.WARN, format="%(levelname)s:%(name)s:%(message)s")

    if not Gtk.init_check():
        sys.stderr.write("Gtk couldn't be initialized. Ensure your display server is running and accessible.\n")
        sys.exit(1)

    app = AkamaiApp(application_id="com.github.mclellac.AkamaiStaging")
    exit_status = app.run(sys.argv)
    sys.exit(exit_status)
